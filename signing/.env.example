# ─────────────────────────────────────────────────────────
# RecoilApp Windows Code Signing Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your certificate details.
# NEVER commit the .env file — it contains secrets.
#
# See README.md in this directory for how to obtain a certificate.
# ─────────────────────────────────────────────────────────

# Absolute path to your .pfx or .p12 certificate file
WIN_CSC_LINK=/home/aurora/RecoilApp/desktop_application/signing/certificate.pfx

# Certificate password
WIN_CSC_KEY_PASSWORD=your-certificate-password-here

# Timestamp server (default is DigiCert, which is free and reliable)
WIN_SIGN_TIMESTAMP=http://timestamp.digicert.com

# Hash algorithm (sha256 is standard, sha384/sha512 also supported)
WIN_SIGN_HASH=sha256
